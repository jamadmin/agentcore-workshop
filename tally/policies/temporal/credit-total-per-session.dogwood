// Temporal policy (Dogwood): refuse issue_credit once the credits requested in this
// policy session, including the current one, add up to more than S$50 within 24 hours.
// Based on the "cumulative budget" example in the AgentCore docs. ${GATEWAY_ARN} is
// filled in by temporal.py. DRAFT: not yet tested in a real account.
forbid (
    principal,
    action == AgentCore::Action::"tally-api___issue_credit",
    resource == AgentCore::Gateway::"${GATEWAY_ARN}"
)
when temporal {
    exists (total: Long).
        (sum amt for (amt: Long), (t: Timepoint).
            where (formerly within 24h (AgentCore::Action::"tally-api___issue_credit"::request{ eventResource: resource, input.amount: amt } && tp(t)))) == total
        && total > 50
};
